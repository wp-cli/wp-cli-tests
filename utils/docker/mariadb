#!/bin/sh
# MariaDB 11.4 and later warn on STDERR that they cannot verify the certificate of a MySQL server
# when the password does not come from the command line, as with MYSQL_PWD that WP-CLI uses. The
# MySQL client on the GitHub runners does not, so scenarios expecting an empty STDERR would only
# fail in the containers. The server is a throwaway in the worker's own network namespace.

# Options about option files have to come first.
defaults=
while :; do
	case "$1" in
		--no-defaults|--print-defaults|--defaults-file=*|--defaults-extra-file=*|--defaults-group-suffix=*) defaults="$defaults $1"; shift ;;
		*) break ;;
	esac
done

# shellcheck disable=SC2086
exec /usr/bin/mariadb $defaults --skip-ssl-verify-server-cert "$@"
